API_URL=http://localhost:8000/api/cloud/sensor-readings
CLOUD_INGESTION_TOKEN=

TOOL_ID=4
UNIT=bar

COUNT=20
MEAN=3.5
STANDARD_DEVIATION=0.1
NORMAL_MIN=2.5
NORMAL_MAX=4.5
SCENARIO=normal_operation

# batch sends COUNT values once. continuous sends one value every INTERVAL_MS.
MODE=batch
INTERVAL_MS=5000
